{
  "name": "mon-dossier-sante",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Mon dossier santé : application hors ligne, en un seul fichier HTML, avec coffre chiffré.",
  "homepage": "https://efix.github.io/mon-dossier-sante",
  "scripts": {
    "build": "node outils/assembler.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "verifier": "node outils/assembler.mjs --verifier && node --test \"tests/*.test.mjs\"",
    "publier": "node outils/publier.mjs",
    "preversion": "npm run verifier",
    "version": "node outils/assembler.mjs && git add Mon-Dossier-Sante.html",
    "postversion": "node outils/publier.mjs --commiter"
  },
  "engines": {
    "node": ">=22"
  }
}
