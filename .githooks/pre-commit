#!/bin/sh
# Refuse un commit dont le HTML livré ne correspond plus aux sources de src/ :
# l'application ouverte ne serait pas celle du code commité, ou ne démarrerait plus.
if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit : node introuvable, assemblage non vérifié." >&2
  exit 0
fi
exec node outils/assembler.mjs --verifier
